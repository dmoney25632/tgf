# Copy to .env.local (gitignored) and fill in. Leave the Supabase values empty
# to run in guest/offline mode: solo play works, accounts/co-op/stats are off.
# Never commit real values. Never add the service-role / secret key here.

# --- App (safe for the browser; also add these in Vercel) ----------------------
# Supabase dashboard → Project Settings → API (or the "Connect" button).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). The legacy anon key also works:
# set NEXT_PUBLIC_SUPABASE_ANON_KEY instead if that's what you have.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used in auth emails and OAuth redirects (no trailing slash).
# Local: http://localhost:3000   Vercel production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional OAuth buttons, comma separated. Whitelist: github, google, discord.
# Each one must also be enabled under Auth → Providers in Supabase.
NEXT_PUBLIC_AUTH_OAUTH_PROVIDERS=

# --- Database (CLI / migrations ONLY: never in Vercel, never NEXT_PUBLIC_) ------
# Dashboard → Connect → Connection string. Replace [YOUR-PASSWORD].
# Transaction pooler (port 6543): for serverless/short-lived connections.
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres
# Session pooler (port 5432) or direct connection: for migrations (`supabase db push --db-url "$DIRECT_URL"`).
DIRECT_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:5432/postgres
